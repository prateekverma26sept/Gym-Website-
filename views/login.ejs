<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <style>
        /* General Styles */
        body {
            font-family: Arial, sans-serif;
            background: url('https://www.bamfitnessandnutrition.com/wp-content/uploads/2023/02/DSC_5440-2022-12-05T02_45_38.170.jpg') no-repeat center center/cover;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            padding: 20px;
        }

        /* Dark Overlay for Readability */
        body::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: 1;
        }

        /* Wrapper Styling */
        .wrapper {
            display: flex;
            width: 80%;
            max-width: 900px;
            height: 85vh;
            background: rgba(255, 255, 255, 0.15); /* Light translucent effect */
            border-radius: 15px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            padding: 20px;
            box-sizing: border-box;
            position: relative;
            z-index: 2;
            backdrop-filter: blur(10px); /* Blur effect */
        }

        /* Form Section (Left Side) */
        .form-section {
            width: 50%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            box-sizing: border-box;
            background: rgba(255, 255, 255, 0.9); /* Semi-transparent white */
            border-radius: 15px 0 0 15px;
            backdrop-filter: blur(10px);
        }

        /* Form Styling */
        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
            font-weight: 600;
        }
        form {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .form-group {
            width: 100%;
            display: flex;
            flex-direction: column;
            margin-bottom: 15px;
        }
        label {
            font-size: 14px;
            margin-bottom: 5px;
            color: #555;
            font-weight: 500;
        }
        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 16px;
            background: #f9f9f9;
            box-sizing: border-box;
            transition: all 0.3s ease-in-out;
        }
        input:focus {
            border-color: #007bff;
            outline: none;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
        }

        /* Button Styling */
        button {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            background: linear-gradient(to right, #007bff, #0056b3);
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s ease-in-out;
        }
        button:hover {
            background: linear-gradient(to right, #0056b3, #003f8a);
        }

        /* Video Section (Right Side) */
        .video-section {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 0 15px 15px 0;
        }
        .video-section video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .wrapper {
                flex-direction: column;
                height: auto;
            }
            .form-section {
                width: 100%;
                padding: 20px;
                border-radius: 15px 15px 0 0;
            }
            .video-section {
                width: 100%;
                height: 250px;
                border-radius: 0 0 15px 15px;
            }
        }
    </style>
</head>
<body>

    <div class="wrapper">
        <!-- Form Section (Left) -->
        <div class="form-section">
            <h1>Login</h1>
            <form action="/login" method="POST">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email" required>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required>
                </div>
                <button type="submit">Login</button>
            </form>
        </div>

        <!-- Video Section (Right) -->
        <div class="video-section">
            <video autoplay muted loop>
                <source src="https://videos.pexels.com/video-files/5319745/5319745-uhd_1440_2560_25fps.mp4" type="video/mp4">
                Your browser does not support the video tag.
            </video>
        </div>
    </div>

</body>
</html>
