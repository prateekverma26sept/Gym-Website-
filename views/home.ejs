<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/styles.css">
    
    <style>
        /* General Styles */
        body {
            font-family: Arial, sans-serif;
            background: url('https://source.unsplash.com/1600x900/?fitness,gym') no-repeat center center/cover;
            margin: 0;
            padding: 0;
            color: white;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 100vh;
            justify-content: center;
            position: relative;
        }

        /* Dark Overlay */
        body::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: -1;
        }

        /* Navigation Bar */
       /* Navigation Bar */
nav {
    width: 100%;
    background: rgba(0, 0, 0, 0.8);
    position: fixed;
    top: 0;
    left: 0;
    padding: 15px 0;
    z-index: 100;
    display: flex;
    justify-content: flex-end;
    padding-right: 30px;
    padding-left: 20px;
}

nav ul {
    list-style: none;
    display: flex;
    padding: 0px;
    margin-top: 20px;
    margin-right: 30px;
}

nav ul li {
    margin: 0 10px; /* Reduced from 15px to 10px */
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-size: 18px;
    padding: 6px 12px; /* Reduced from 8px 15px */
    border-radius: 5px;
    transition: background 0.3s ease;
}

nav ul li a:hover {
    background: rgba(255, 255, 255, 0.2);
}
        /* Main Content */
        h1 {
            font-size: 3rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
        }

        p {
            font-size: 1.2rem;
            background: rgba(0, 0, 0, 0.5);
            padding: 10px 20px;
            border-radius: 10px;
            display: inline-block;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            h1 {
                font-size: 2rem;
            }
            p {
                font-size: 1rem;
                padding: 8px 15px;
            }
            nav {
                justify-content: center; /* Center nav items on smaller screens */
                padding-right: 0;
            }
            nav ul {
                flex-direction: column;
                align-items: center;
            }
            nav ul li {
                margin: 8px 0;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <% if (!loggedIn) { %>
                <li><a href="/login">Login</a></li>
                <li><a href="/signup">Sign Up</a></li>
            <% } else { %>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/logout">Logout</a></li>
            <% } %>
        </ul>
    </nav>

    <!-- Main Content -->
    <h1>Welcome to Our App</h1>
    
    
</body>
</html>
